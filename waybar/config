{
	"layer": "top",
	"position": "top",
    "output":["DP-2"],
	"spacing": 4,

	"include": [
		"~/.config/waybar/modules.json"
	],


	"modules-left" : [
		"hyprland/workspaces"
	],

	"modules-center" : [
		"clock"
	],

	"modules-right": [
        "keyboard-state",
		"pulseaudio",
        "network",
		"group/hardware",
        "temperature",
        "battery",
		"custom/exit"
	],

	"group/hardware": {
		"orientation": "horizontal",
		"modules": [
			"disk",
			"cpu",
			"memory"
		]
	}
}
